# LLM Configuration
# OpenRouter API key (supports Claude, GPT, and other models via single API)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Alternative: Direct provider API keys (if not using OpenRouter)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# LLM Provider & Model Configuration
# Options: 'openrouter', 'anthropic', 'openai'
CLASSIFIER_LLM_PROVIDER=openrouter

# Default model (used by all agents if not overridden)
# OpenRouter format: 'anthropic/claude-3-5-haiku-latest'
# Direct Anthropic: 'claude-3-5-haiku-latest'
CLASSIFIER_MODEL=anthropic/claude-3-5-haiku-latest

# GitHub Token (for ColabIP sync)
GITHUB_TOKEN=your_github_personal_access_token_here

# Optional: Override default project storage location
# Default: ./projects/
# PROJECT_DIR=/path/to/custom/projects

# Optional: ColabIP repository configuration
# Default: ./colabip/
# COLABIP_DIR=/path/to/custom/colabip
# COLABIP_REPO_URL=https://github.com/your-org/colabip.git

# Optional: Logging level
# Options: 'debug', 'info', 'warn', 'error'
# LOG_LEVEL=info
