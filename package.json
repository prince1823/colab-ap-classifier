{
  "name": "colab-ap-classifier",
  "version": "1.6.0",
  "description": "Electron desktop app for automated classification of accounts payable transactions using LLMs",
  "private": true,
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "concurrently -n main,renderer \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:log": "LOG_FILE=/tmp/c91-debug.log concurrently -n main,renderer \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:trace": "LOG_FILE=/tmp/c91-debug.log LLM_TRACE_FILE=/tmp/c91-trace.jsonl concurrently -n main,renderer \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:trace:lifepoint100": "LOG_FILE=/tmp/c91-lifepoint100-debug.log LLM_TRACE_FILE=/tmp/c91-lifepoint100-trace.jsonl concurrently -n main,renderer \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json && electron dist/main/main/index.js",
    "dev:renderer": "vite",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build:dist": "npm run build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mock": "vitest run tests/integration/classifier-mock.test.ts",
    "test:run": "vitest run tests/integration/classifier-real-run.test.ts",
    "test:integration": "vitest run tests/integration/",
    "test:heavy": "RUN_HEAVY=1 vitest run tests/integration/classification-scope-stack.test.ts --pool=forks --poolOptions.forks.singleFork=true",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
    "script:inspect": "tsx scripts/inspect-c91.ts",
    "script:verify-llm": "tsx scripts/verify-llm-config.ts",
    "script:test-llm": "tsx scripts/test-llm-config.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.4.4-r.1",
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-popover": "^1.0.6",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.18",
    "buffer": "^6.0.3",
    "clsx": "^2.0.0",
    "csv-parse": "^5.6.0",
    "exa-js": "^2.3.0",
    "lucide-react": "^0.563.0",
    "papaparse": "^5.5.3",
    "react": "^18.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1",
    "recharts": "^2.10.3",
    "sonner": "^2.0.7",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.1.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  }
}
